            with urllib.request.urlopen(urllib.request.Request(url, headers={"User-Agent": "bobocodexultra/1"}), timeout=20) as response:
                raw = response.read(12_000_001)
                if len(raw) > 12_000_000:
                    raise SetupError("OpenRouter pricing response is unexpectedly large.")
                models = json.loads(raw)["data"]
    except (urllib.error.URLError, KeyError, ValueError) as exc:
        raise SetupError(f"Could not load OpenRouter pricing: {exc}") from exc
    return [m for m in models if isinstance(m, dict) and isinstance(m.get("id"), str)
            and MODEL_ID.fullmatch(m["id"])]


def model_record(model: dict) -> dict:
    context = model.get("context_length")
    if not isinstance(context, int) or context < 8192:
        raise SetupError(f"{model['id']} does not advertise a usable context length.")
    return {"id": model["id"], "name": safe_text(model.get("name")) or model["id"],
            "context_length": context,
            "images": "image" in (model.get("architecture") or {}).get("input_modalities", [])}


def model_price(model: dict, key: str) -> Decimal | None:
    """OpenRouter's base token price, converted to approximate USD per million."""
    raw = (model.get("pricing") or {}).get(key)
    try:
        value = Decimal(str(raw)) * 1_000_000
        return value if value.is_finite() and value >= 0 else None
    except (InvalidOperation, TypeError):
        return None


def manager_catalog(chosen: dict) -> list[dict]:
    available = openrouter_models("", None)
    ids = {m["id"] for m in available}
    for record in chosen["models"]:
        if record["id"] not in ids:
            available.append({
                "id": record["id"], "name": record["name"],
                "context_length": record["context_length"],
                "architecture": {"input_modalities": ["text", "image"] if record["images"] else ["text"]},
                "supported_parameters": [], "description": "Previously selected; not currently in the tool-capable listing.",
                "_unavailable": True,
            })
    for rank, model in enumerate(available):
        model["_rank"] = rank
    return available


SORT_MODES = ("popular", "name", "context", "input price", "output price", "selected first")


def manager_view(available: list[dict], selected: set[str], query: str, sort_mode: str) -> list[dict]:
    words = query.casefold().split()
    visible = [m for m in available if all(
        word in (m["id"] + " " + safe_text(m.get("name"), 160) + " " +
                 safe_text(m.get("description"), 200)).casefold() for word in words
    )]
    if sort_mode == "name":
        return sorted(visible, key=lambda m: (safe_text(m.get("name")).casefold(), m["id"]))
    if sort_mode == "context":
        return sorted(visible, key=lambda m: (-m.get("context_length", 0), m["_rank"]))
    if sort_mode in ("input price", "output price"):
        key = "prompt" if sort_mode == "input price" else "completion"
        return sorted(visible, key=lambda m: (model_price(m, key) is None,
                                               model_price(m, key) or Decimal(0), m["_rank"]))
    if sort_mode == "selected first":
        return sorted(visible, key=lambda m: (m["id"] not in selected, m["_rank"]))
    return sorted(visible, key=lambda m: m["_rank"])


def manager_result(chosen: dict, selected: set[str], default: str, available: list[dict]) -> dict:
    if not selected:
        raise SetupError("Choose at least one model before saving.")
    by_id = {m["id"]: m for m in available}
    prior = [m["id"] for m in chosen["models"] if m["id"] in selected]
    additional = [m["id"] for m in available if m["id"] in selected and m["id"] not in prior]
    order = prior + additional
    prior_records = {m["id"]: m for m in chosen["models"]}
    result = copy.deepcopy(chosen)
    result["models"] = [copy.deepcopy(prior_records[slug]) if slug in prior_records
                        else model_record(by_id[slug]) for slug in order]
    result["default"] = default if default in selected else order[0]
    return result


def model_manager(chosen: dict, query: str = "", sort_mode: str = "popular") -> None:
    """Full-screen, staged multi-model picker. Escape/cancel writes nothing."""
    if not sys.stdin.isatty() or not sys.stdout.isatty() or os.environ.get("TERM") == "dumb":
        raise SetupError("The model manager needs an interactive terminal (TERM=xterm-256color or similar). "
                         "For scripts, use `model add author/model-id` or `model remove author/model-id`.")
    try:
        import curses
    except ImportError as exc:
        raise SetupError("This Python installation has no curses support.") from exc

    UI.row("LOADING", "OpenRouter's tool-capable model catalog; no model call or charge.", "amber")
    available = manager_catalog(chosen)
    if not available:
        raise SetupError("OpenRouter returned no tool-capable models.")
    selected = {m["id"] for m in chosen["models"]}
    dirty_config = False
    p = paths()
    starting_selection = sha(p["selection"].read_bytes()) if p["selection"].exists() else None
    if p["state"].exists():
        state = json.loads(p["state"].read_text())
        dirty_config = not p["config"].exists() or sha(p["config"].read_bytes()) != state["active_sha256"]

    def screen(stdscr):
        try:
            curses.curs_set(0)
        except curses.error:
            pass
        stdscr.keypad(True)
        if UI.color and curses.has_colors():
            curses.start_color()
            try:
                curses.use_default_colors()
            except curses.error:
                pass
            for number, foreground in ((1, curses.COLOR_MAGENTA), (2, curses.COLOR_CYAN),
                                       (3, curses.COLOR_GREEN), (4, curses.COLOR_YELLOW)):
                try:
                    curses.init_pair(number, foreground, -1)
                except curses.error:
                    curses.init_pair(number, foreground, curses.COLOR_BLACK)

        def color(number: int, extra: int = 0) -> int:
            return (curses.color_pair(number) if UI.color and curses.has_colors() else 0) | extra

        def draw(y: int, x: int, value: str, width: int, attribute: int = 0) -> None:
            height, columns = stdscr.getmaxyx()
            if y < 0 or y >= height or x < 0 or x >= columns - 1:
                return
            try:
                stdscr.addnstr(y, x, value, max(0, min(width, columns - x - 1)), attribute)
            except curses.error:
                pass

        staged = set(selected)
        default = chosen["default"]
        search = safe_text(query, 100)
        editing = False
        help_open = False
        detail_open = False
        order = sort_mode
        cursor = 0
        scroll = 0
        message = "Space toggles models; Enter saves; Q cancels without changes."

        while True:
            height, columns = stdscr.getmaxyx()
            stdscr.erase()
            if height < 17 or columns < 70:
                draw(1, 2, "Resize the terminal to at least 70 × 17.", columns - 4, color(4))
                draw(3, 2, "Q or Esc cancels.", columns - 4)
                stdscr.refresh()
                key = stdscr.get_wch()
                if key in ("q", "Q", "\x1b", 27):
                    return None
                continue

            if help_open:
                help_lines = [
                    "MODEL MANAGER / KEYBOARD GUIDE", "",
                    "/      Search by name, provider, ID, or description (updates as you type)",
                    "S      Cycle popular, name, context, price, selected-first sorting",
                    "↑ ↓    Scroll one model (J/K also work)",
                    "PgUp/PgDn, G, Shift+G    Jump through long lists",
                    "Space  Toggle the highlighted model; select as many as you like",
                    "D      Make the highlighted model your default (selects it too)",
                    "X      Remove the highlighted model from your selection",
                    "I/Tab  Open full model details (also useful in narrow terminals)",
                    "Enter  Save all staged changes to the Codex selector",
                    "Q/Esc  Cancel without saving", "",
                    "Only models advertising tool support appear; live Codex compatibility",
                    "and pricing are not guaranteed. A Codex restart refreshes its selector.",
                    "", "Press ? or Esc to return.",
                ]
                for y, line in enumerate(help_lines, 1):
                    draw(y, 3, line, columns - 6, color(2 if y == 1 else 0))
                stdscr.refresh()
                key = stdscr.get_wch()
                if key in ("?", "\x1b", 27):
                    help_open = False
                continue

            visible = manager_view(available, staged, search, order)
            cursor = max(0, min(cursor, len(visible) - 1))

            if detail_open and visible:
                model = visible[cursor]
                input_price, output_price = model_price(model, "prompt"), model_price(model, "completion")
                detail_lines = [
                    "MODEL DETAILS / " + safe_text(model.get("name")), "",
                    "ID: " + model["id"],
                    "Context: " + str(model.get("context_length") or "unknown") + " tokens",
                    "Input base price: " + (f"${input_price:,.3f}/M tokens" if input_price is not None else "unknown"),
                    "Output base price: " + (f"${output_price:,.3f}/M tokens" if output_price is not None else "unknown"),
                    "Input modalities: " + ", ".join((model.get("architecture") or {}).get("input_modalities") or []),
                    "Tool calling: " + ("not currently listed" if model.get("_unavailable") else "advertised"),
                    "Selected: " + ("yes" if model["id"] in staged else "no"),
                    "Default: " + ("yes" if model["id"] == default else "no"), "",
                    "ABOUT",
                    *textwrap.wrap(safe_text(model.get("description"), 600), max(25, columns - 7)),
                ]
                draw(0, 2, "✦ BOBO / CODEX ULTRA     MODEL DETAILS", columns - 4, color(1, curses.A_BOLD))
                for y, line in enumerate(detail_lines, 2):
                    if y >= height - 3:
                        break
                    draw(y, 3, line, columns - 6, color(2 if y in (2, 13) else 0))
                draw(height - 2, 3, "I / Tab / Esc to return to the model list.", columns - 6, color(4))
                stdscr.refresh()
                key = stdscr.get_wch()
                if key in ("i", "I", "\t", "\x1b", 27):
                    detail_open = False
                continue

            page = height - 9
            scroll = max(0, min(scroll, max(0, len(visible) - page)))
            if cursor < scroll:
                scroll = cursor
            if cursor >= scroll + page:
                scroll = cursor - page + 1
            side = columns >= 102
            list_width = max(42, int(columns * 0.57)) if side else columns - 2

            draw(0, 2, "✦ BOBO / CODEX ULTRA     MODEL MANAGER", columns - 4, color(1, curses.A_BOLD))
            draw(1, 2, f"{len(visible)}/{len(available)} shown   •   {len(staged)} selected   •   sort: {order}",
                 columns - 4, color(2))
            search_label = ("SEARCH › " if editing else "Filter: ") + (search or "all tool-capable models")
            draw(2, 2, search_label + ("_" if editing else ""), columns - 4, color(4 if editing else 0))
            draw(3, 1, "─" * (columns - 3), columns - 2, color(1))
            draw(4, 2, "MODELS   ★ default   ◆ selected   ◇ available", list_width - 3, color(2))

            if not visible:
                draw(6, 3, "No matches. Backspace to broaden the search.", list_width - 4, color(4))
            for offset, model in enumerate(visible[scroll:scroll + page]):
                index = scroll + offset
                slug = model["id"]
                badge = "★" if slug == default else ("◆" if slug in staged else "◇")
                name = safe_text(model.get("name")) or slug
                unavailable = " [unlisted]" if model.get("_unavailable") else ""
                line = f"{badge} {name}  ·  {slug}{unavailable}"
                attr = color(3 if slug in staged else 2)
                if index == cursor:
                    attr = color(1, curses.A_REVERSE | curses.A_BOLD)
                draw(5 + offset, 2, line, list_width - 4, attr)

            if side:
                divider_x = list_width
                for y in range(4, height - 4):
                    draw(y, divider_x, "│", 1, color(1))
                detail_x, detail_width = divider_x + 2, columns - divider_x - 4
                draw(4, detail_x, "MODEL DETAILS", detail_width, color(2, curses.A_BOLD))
                if visible:
                    model = visible[cursor]
                    slug = model["id"]
                    input_price, output_price = model_price(model, "prompt"), model_price(model, "completion")
                    def price(value):
                        return f"${value:,.3f}/M tokens" if value is not None else "unknown"
                    details = [
                        ("NAME", safe_text(model.get("name"))), ("ID", slug),
                        ("CONTEXT", f"{model.get('context_length'):,} tokens" if isinstance(model.get("context_length"), int)
                         else "unknown"),
                        ("INPUT BASE", price(input_price)), ("OUTPUT BASE", price(output_price)),
                        ("INPUT", ", ".join((model.get("architecture") or {}).get("input_modalities") or []) or "unknown"),
                        ("TOOLS", "advertised" if not model.get("_unavailable") else "not currently listed"),
                        ("STATE", "selected" if slug in staged else "not selected"),
                    ]
                    y = 6
                    for label, value in details:
                        draw(y, detail_x, label, detail_width, color(4, curses.A_BOLD))
                        y += 1
                        for wrapped in textwrap.wrap(safe_text(value, 180), max(12, detail_width - 1))[:2]:
                            draw(y, detail_x, wrapped, detail_width)
                            y += 1
                        y += 1
                        if y >= height - 10:
                            break
                    if y < height - 7:
                        draw(y, detail_x, "ABOUT", detail_width, color(4, curses.A_BOLD))
                        for line_number, wrapped in enumerate(textwrap.wrap(safe_text(model.get("description"), 300),
                                                                          max(12, detail_width - 1))[:height - y - 8], y + 1):
                            draw(line_number, detail_x, wrapped, detail_width)

            draw(height - 4, 1, "─" * (columns - 3), columns - 2, color(1))
            draw(height - 3, 2, "SPACE toggle    D default    / search    S sort    I details    ? help", columns - 4, color(2))
            draw(height - 2, 2, "↑↓/JK scroll    PgUp/PgDn jump    ENTER save    Q cancel", columns - 4, color(3))
            notice = ("Config edited: desktop off needs a manual merge.  " if dirty_config else "") + message
            draw(height - 1, 2, notice, columns - 4, color(4))
            stdscr.refresh()

            key = stdscr.get_wch()
            if editing:
                if key in ("\n", "\r", curses.KEY_ENTER, "\x1b", 27):
                    editing = False
                elif key in ("\b", "\x7f", curses.KEY_BACKSPACE, 127, 8):
                    search = search[:-1]
                    cursor = scroll = 0
                elif key == "\x15":
                    search = ""
                    cursor = scroll = 0
                elif isinstance(key, str) and key.isprintable() and len(search) < 80:
                    search += key
                    cursor = scroll = 0
                continue

            if key in ("q", "Q", "\x1b", 27):
                return None
            if key == "?":
                help_open = True
            elif key in ("i", "I", "\t") and visible:
                detail_open = True
            elif key == "/":
                editing = True
            elif key in ("s", "S"):
                highlighted = visible[cursor]["id"] if visible else None
                order = SORT_MODES[(SORT_MODES.index(order) + 1) % len(SORT_MODES)]
                resorted = manager_view(available, staged, search, order)
                cursor = next((i for i, model in enumerate(resorted) if model["id"] == highlighted), 0)
                scroll = max(0, cursor - page // 2)
            elif key in (curses.KEY_DOWN, "j", "J"):
                cursor = min(len(visible) - 1, cursor + 1)
            elif key in (curses.KEY_UP, "k", "K"):
                cursor = max(0, cursor - 1)
            elif key in (curses.KEY_NPAGE,):
                cursor = min(len(visible) - 1, cursor + page)
            elif key in (curses.KEY_PPAGE,):
                cursor = max(0, cursor - page)
            elif key in ("g", curses.KEY_HOME):
                cursor = 0
            elif key in ("G", curses.KEY_END):
                cursor = max(0, len(visible) - 1)
            elif key in (" ", "x", "X", "d", "D") and visible:
                slug = visible[cursor]["id"]
                if key in ("d", "D"):
                    staged.add(slug)
                    default = slug
                    message = f"Default staged: {slug}"
                else:
                    if key == " " and slug not in staged:
                        staged.add(slug)
                    else:
                        staged.discard(slug)
                    if slug == default and slug not in staged:
                        default = next((model["id"] for model in available if model["id"] in staged), "")
                    message = f"{len(staged)} models staged; press Enter to save."
            elif key in ("\n", "\r", curses.KEY_ENTER):
                if not staged:
                    message = "Select at least one model before saving."
                else:
                    return manager_result(chosen, staged, default, available)

    try:
        updated = curses.wrapper(screen)
    except curses.error as exc:
        raise SetupError(f"Could not start the terminal model manager: {exc}") from exc
    if updated is None:
        UI.row("CANCELLED", "No model changes were saved.", "amber")
    elif (updated["models"], updated["default"]) == (chosen["models"], chosen["default"]):
        UI.done("Selection unchanged.")
    else:
        current_selection = sha(p["selection"].read_bytes()) if p["selection"].exists() else None
        if current_selection != starting_selection:
            raise SetupError("The selection changed while the manager was open. Reopen it to preserve those edits.")
        update_selection(updated)


def update_selection(chosen: dict) -> None:
    p = paths()
    old = selection()
    verify_managed(old, p)
    ids = [m["id"] for m in chosen["models"]]
    if not ids or len(set(ids)) != len(ids) or chosen["default"] not in ids:
        raise SetupError("Choose at least one unique model and a default from that selection.")
    catalog, profile = catalog_bytes(p["home"], chosen), profile_bytes(p["catalog"], chosen["default"])
    tomllib.loads(profile.decode())
    active = None
    desktop_state = None
    dirty_desktop = False
    if p["state"].exists():
        desktop_state = json.loads(p["state"].read_text())
        current = p["config"].read_bytes()
        if sha(current) != desktop_state["active_sha256"]:
            try:
                current_config = tomllib.loads(current.decode())
            except (ValueError, UnicodeDecodeError) as exc:
                raise SetupError(f"Edited desktop config cannot be parsed: {exc}") from exc
            if (current_config.get("model") != old["default"]
                    or current_config.get("model_provider") != "openrouter"
                    or current_config.get("model_catalog_json") != str(p["catalog"])
                    or START_MARKER not in current.decode() or END_MARKER not in current.decode()):
                raise SetupError("Desktop config changed its model or provider; no model changes made. Merge it first.")
            dirty_desktop = True
            active = replace_root_keys(current.decode(), {"model": json.dumps(chosen["default"])})
            tomllib.loads(active)
        else:
            active = replace_root_keys(current.decode(), {"model": json.dumps(chosen["default"])})
            tomllib.loads(active)
    # Prepared files belong to this tool; preserve copies before replacing them.
    for label, data in (("catalog", catalog), ("profile", profile)):
        if p[label].exists() and p[label].read_bytes() == data:
            continue
        if p[label].exists():
            backup = p[label].with_name(f"{p[label].name}.backup-{time.strftime('%Y%m%d-%H%M%S')}-{os.getpid()}")
            atomic_write(backup, p[label].read_bytes())
        atomic_write(p[label], data)
    if active is not None and active.encode() != current:
        atomic_write(p["config"], active.encode())
        if not dirty_desktop:
            desktop_state["active_sha256"] = sha(active.encode())
            atomic_write(p["state"], (json.dumps(desktop_state, indent=2) + "\n").encode())
    chosen.update(catalog_sha256=sha(catalog), profile_sha256=sha(profile))
    selected_data = (json.dumps(chosen, indent=2) + "\n").encode()
    if not p["selection"].exists() or p["selection"].read_bytes() != selected_data:
        atomic_write(p["selection"], selected_data)
    refresh_mixed_catalog()
    UI.done(f"{len(ids)} models selected; default: {chosen['default']}.")
    UI.row("NEXT", "Restart Codex to refresh the selector; existing tasks may retain settings.")
    if dirty_desktop:
        UI.row("CONFIG NOTICE", "Your desktop config edits were preserved; desktop off still requires a manual merge.", "amber")


def sync_selection_artifacts() -> None:
    """Regenerate BCU labels/profile without reading or changing the desktop config."""
    p = paths()
    chosen = selection()
    verify_managed(chosen, p)
    catalog = catalog_bytes(p["home"], chosen)
    profile = profile_bytes(p["catalog"], chosen["default"])
    tomllib.loads(profile.decode())
    for label, data in (("catalog", catalog), ("profile", profile)):
        if p[label].exists() and p[label].read_bytes() == data:
            continue
        if p[label].exists():
            backup = p[label].with_name(f"{p[label].name}.backup-{time.strftime('%Y%m%d-%H%M%S')}-{os.getpid()}")
            atomic_write(backup, p[label].read_bytes())
        atomic_write(p[label], data)
    chosen.update(catalog_sha256=sha(catalog), profile_sha256=sha(profile))
    atomic_write(p["selection"], (json.dumps(chosen, indent=2) + "\n").encode())
    refresh_mixed_catalog()
    UI.done(f"Refreshed {len(chosen['models'])} BCU selector labels without changing desktop settings.")
    UI.row("NEXT", "Quit and relaunch Codex to reload the model catalog.")


def model_commands(args: argparse.Namespace) -> None:
    chosen = selection()
    current = [m["id"] for m in chosen["models"]]
    if args.action in (None, "manage", "select"):
        model_manager(chosen, getattr(args, "query", ""))
    elif args.action in ("add", "remove", "default") and args.model is None:
        model_manager(chosen, sort_mode="selected first" if args.action != "add" else "popular")
    elif args.action == "list":
        UI.section("Models in selector")
        for m in chosen["models"]:
            star = "★" if m["id"] == chosen["default"] else "·"
            print("  " + UI.paint(star, "amber" if star == "★" else "violet") + " " +
                  UI.paint(m["id"], "cyan") + UI.paint("  /  " + safe_text(m["name"]), "dim"))
        UI.row("★ DEFAULT", "Desktop OpenRouter mode exposes this selected list.", "amber")
    elif args.action == "search":
        available = openrouter_models(args.query, 40)
        UI.section(f"OpenRouter results for {args.query or 'popular models'}")
        for m in available:
            badge = UI.paint("  ✓ SELECTED", "mint") if m["id"] in current else ""
            print("  " + UI.paint(m["id"], "cyan") +
                  UI.paint(f"  /  {safe_text(m.get('name'))} · {m.get('context_length', '?')} context", "dim") + badge)
    elif args.action == "add":
        if not MODEL_ID.fullmatch(args.model):
            raise SetupError("Use an exact OpenRouter model ID, such as anthropic/claude-opus-5.")
        matches = openrouter_models(args.model, 1000)
        found = next((m for m in matches if m["id"] == args.model), None)
        if found is None:
            raise SetupError("Model not found in OpenRouter's tool-capable catalog; use `model search`.")
        if args.model not in current:
            chosen["models"].append(model_record(found))
        update_selection(chosen)
    elif args.action == "remove":
        if args.model not in current:
            raise SetupError("That model is not selected.")
        chosen["models"] = [m for m in chosen["models"] if m["id"] != args.model]
        if chosen["models"] and chosen["default"] == args.model:
            chosen["default"] = chosen["models"][0]["id"]
        update_selection(chosen)
    elif args.action == "default":
        if args.model not in current:
            raise SetupError("Add the model with `model add` before making it the default.")
        chosen["default"] = args.model
        update_selection(chosen)
    elif args.action == "sync":
        sync_selection_artifacts()


def replace_root_keys(original: str, updates: dict[str, str]) -> str:
    lines = original.splitlines(keepends=True)
    first_table = next((i for i, line in enumerate(lines) if re.match(r"^\s*\[", line)), len(lines))
    head, tail = lines[:first_table], lines[first_table:]
    present: set[str] = set()
    replacement = []
    pattern = re.compile(r"^\s*(model|model_provider|model_catalog_json|model_reasoning_effort)\s*=")
    for line in head:
        match = pattern.match(line)
        if match and match.group(1) in updates:
            key = match.group(1)
            if key in present:
                raise SetupError(f"Duplicate top-level {key} in existing Codex config.")
            present.add(key)
            replacement.append(f"{key} = {updates[key]}\n")
        else:
            replacement.append(line)
    if replacement and not replacement[-1].endswith("\n"):
        replacement[-1] += "\n"
    for key in MANAGED_KEYS:
        if key in updates and key not in present:
            replacement.append(f"{key} = {updates[key]}\n")
    return "".join(replacement + tail)


def desktop_on() -> None:
    p = paths()
    if not p["profile"].is_file() or not p["catalog"].is_file():
        raise SetupError("Run `bobocodexultra auth login` first.")
    if not key_exists():
        raise SetupError("No Keychain item found. Run `bobocodexultra auth login` in Terminal.")
    if p["state"].exists():
        raise SetupError("Desktop OpenRouter mode is already active; run `status` or `desktop off`.")
    config = p["config"]
    original = config.read_bytes() if config.exists() else b""
    try:
        parsed = tomllib.loads(original.decode())
    except (ValueError, UnicodeDecodeError) as exc:
        raise SetupError(f"Existing Codex config cannot be parsed: {exc}") from exc
    if "openrouter" in parsed.get("model_providers", {}):
        raise SetupError("An OpenRouter provider already exists in the main config; refusing to replace it.")
    if START_MARKER in original.decode() or END_MARKER in original.decode():
        raise SetupError("A previous managed provider block exists; inspect the config manually.")
    updates = {
        "model": json.dumps(selection()["default"]),
        "model_provider": json.dumps("openrouter"),
        "model_catalog_json": json.dumps(str(p["catalog"])),
        "model_reasoning_effort": json.dumps("high"),
    }
    modified = replace_root_keys(original.decode(), updates).rstrip() + "\n\n"
    modified += START_MARKER + "\n" + provider_toml() + END_MARKER + "\n"
    tomllib.loads(modified)
    p["backups"].mkdir(mode=0o700, parents=True, exist_ok=True)
    backup = p["backups"] / f"config-{time.strftime('%Y%m%d-%H%M%S')}-{os.getpid()}.toml"
    with backup.open("xb") as handle:
        os.fchmod(handle.fileno(), 0o600)
        handle.write(original)
        handle.flush()
        os.fsync(handle.fileno())
    active = modified.encode()
    original_mode = stat.S_IMODE(config.stat().st_mode) if config.exists() else 0o600
    state = {
        "backup": str(backup), "original_sha256": sha(original),
        "active_sha256": sha(active), "original_mode": original_mode,
    }
    atomic_write(config, active)
    atomic_write(p["state"], (json.dumps(state, indent=2) + "\n").encode())
    UI.done("Desktop OpenRouter mode is active in your user-level Codex config.")
    UI.row("BACKUP", str(backup), "mint")
    UI.row("NEXT", "Quit and relaunch Codex to refresh its model selector.")


def desktop_off() -> None:
    p = paths()
    if not p["state"].is_file():
        UI.done("Desktop OpenRouter mode is not active; nothing to restore.")
        return
    state = json.loads(p["state"].read_text())
    backup = Path(state["backup"]).resolve()
    if backup.parent != p["backups"].resolve():
        raise SetupError("Backup path in state file is outside the managed backup folder.")
    original, active = backup.read_bytes(), p["config"].read_bytes()
    if sha(original) != state["original_sha256"]:
        raise SetupError("Backup checksum mismatch; no changes made.")
    if sha(active) != state["active_sha256"]:
        raise SetupError(
            "Codex config changed while OpenRouter mode was active. To preserve those edits, "
            f"restore/merge manually from {backup}; no changes were made."
        )
    atomic_write(p["config"], original, state["original_mode"])
    p["state"].unlink()
    UI.done("Original Codex configuration restored.")
    UI.row("BACKUP", str(backup), "mint")
    UI.row("NEXT", "Quit and relaunch Codex to refresh its model selector.")


def native_reset() -> None:
    """Restore BCU-owned root settings while preserving unrelated edits made later."""
    p = paths()
    if not p["state"].is_file():
        UI.done("Codex is already in native mode; no BCU desktop state was found.")
        return
    state = json.loads(p["state"].read_text())
    backup = Path(state["backup"]).resolve()
    if backup.parent != p["backups"].resolve() or not backup.is_file():
        raise SetupError("The original Codex backup is missing or outside BCU's backup folder.")
    original = backup.read_bytes()
    current = p["config"].read_bytes()
    if sha(original) != state["original_sha256"]:
        raise SetupError("Original backup checksum mismatch; native reset made no changes.")
    try:
        original_config = tomllib.loads(original.decode())
        tomllib.loads(current.decode())
    except (ValueError, UnicodeDecodeError) as exc:
        raise SetupError(f"Codex configuration cannot be safely reset: {exc}") from exc
    text = current.decode()
    block = re.compile(re.escape(START_MARKER) + r"\n.*?" + re.escape(END_MARKER) + r"\n?", re.S)
    if not block.search(text):
        raise SetupError("BCU's managed provider block is missing; native reset made no changes.")
    text = block.sub("", text)
    lines = text.splitlines(keepends=True)
    first_table = next((i for i, line in enumerate(lines) if re.match(r"^\s*\[", line)), len(lines))
    head, tail = lines[:first_table], lines[first_table:]
    pattern = re.compile(r"^\s*(model|model_provider|model_catalog_json|model_reasoning_effort)\s*=")
    restored: list[str] = []
    seen: set[str] = set()
    for line in head:
        match = pattern.match(line)
        if not match:
            restored.append(line)
            continue
        key = match.group(1)
        if key in seen:
            raise SetupError(f"Duplicate top-level {key}; native reset made no changes.")
        seen.add(key)
        if key in original_config:
            restored.append(f"{key} = {json.dumps(original_config[key])}\n")
        # A BCU-added key absent from the original is intentionally removed.
    for key in MANAGED_KEYS:
        if key in original_config and key not in seen:
            restored.append(f"{key} = {json.dumps(original_config[key])}\n")
    merged = ("".join(restored + tail).rstrip() + "\n").encode()
    parsed = tomllib.loads(merged.decode())
    if "openrouter" in parsed.get("model_providers", {}):
        raise SetupError("OpenRouter provider remains after merge; native reset made no changes.")
    p["backups"].mkdir(mode=0o700, parents=True, exist_ok=True)
    recovery = p["backups"] / f"pre-native-reset-{time.strftime('%Y%m%d-%H%M%S')}-{os.getpid()}.toml"
    with recovery.open("xb") as handle:
        os.fchmod(handle.fileno(), 0o600)
        handle.write(current)
        handle.flush()
        os.fsync(handle.fileno())
    atomic_write(p["config"], merged, state.get("original_mode", 0o600))
    p["state"].unlink()
    UI.done("Codex desktop configuration is back in native mode.")
    UI.row("PRESERVED", "Unrelated settings changed after BCU activation were retained.", "mint")
    UI.row("RECOVERY", str(recovery), "mint")
    UI.row("NEXT", "Quit and relaunch Codex to reload the native model selector.")


