def safe_text(value: object, limit: int = 100) -> str:
    """Prevent public model metadata from writing control sequences to the terminal."""
    if not isinstance(value, str):
        return ""
    return "".join(char for char in value if char.isprintable() and char not in "\u202a\u202b\u202c\u202d\u202e").strip()[:limit]


def selector_name(name: str) -> str:
    """Mark only the visible label, never the OpenRouter model ID."""
    clean = re.sub(r"^(?:OpenRouter\s*·\s*)|(?:\s*\(BCU\))+$", "", safe_text(name)).strip()
    # OpenRouter display names use "Provider: Model". Require whitespace
    # after the colon so model qualifiers such as "Qwen3:30b" stay intact.
    clean = re.sub(r"^[^:]+:\s+", "", clean, count=1).strip()
    clean = clean[:1].upper() + clean[1:]
    return f"{clean} (BCU)"


