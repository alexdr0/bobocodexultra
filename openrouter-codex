class TerminalUI:
    """A quiet plain-text UI for pipes, and a neon one for interactive terminals."""

    def __init__(self) -> None:
        self.color = sys.stdout.isatty() and not os.environ.get("NO_COLOR") and os.environ.get("TERM") != "dumb"
        self.motion = (self.color and sys.stderr.isatty() and not os.environ.get("CI")
                       and not os.environ.get("BOBOCODEXULTRA_NO_ANIM"))

    def paint(self, value: str, shade: str) -> str:
        if not self.color:
            return value
        colors = {"pink": "\033[38;2;255;93;211m", "violet": "\033[38;2;163;108;255m",
                  "cyan": "\033[38;2;73;224;241m", "mint": "\033[38;2;105;255;180m",
                  "amber": "\033[38;2;255;205;100m", "dim": "\033[2m"}
        return colors[shade] + value + "\033[0m"

    def heading(self, subtitle: str) -> None:
        logo = "✦  BOBO / CODEX ULTRA"
        if self.motion:
            for index, character in enumerate(logo):
                sys.stdout.write(self.paint(character, ("pink", "violet", "cyan")[index % 3]))
                sys.stdout.flush()
                time.sleep(0.006)
            print()
        else:
            print(self.paint(logo, "pink"))
        print(self.paint("   ╰─ " + subtitle, "cyan"))
        print(self.paint("   " + "━" * 39, "violet"))

    def section(self, name: str) -> None:
        print("\n" + self.paint("◆ " + name.upper(), "violet"))

    def row(self, label: str, detail: str, shade: str = "cyan") -> None:
        print("  " + self.paint(f"{label:<17}", shade) + detail)

    def done(self, message: str) -> None:
        print(self.paint("✓ ", "mint") + message)

    @contextmanager
    def spinner(self, message: str):
        if not self.motion:
            yield
            return
        stopped = threading.Event()

        def animate() -> None:
            frames = "◐◓◑◒"
            index = 0
            while not stopped.wait(0.1):
                sys.stderr.write("\r" + self.paint(frames[index % len(frames)], "pink") + " " + message)
                sys.stderr.flush()
                index += 1
            sys.stderr.write("\r" + " " * (len(message) + 4) + "\r")
            sys.stderr.flush()

        worker = threading.Thread(target=animate, daemon=True)
        worker.start()
        try:
            yield
        finally:
            stopped.set()
            worker.join(timeout=1)


