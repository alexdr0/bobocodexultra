            install()
        elif args.command in ("snake", "pong", "doom"):
            try:
                games_module().run(args.command)
            except games_module().GameError as exc:
                raise SetupError(str(exc)) from exc
        elif args.command == "model":
            model_commands(args)
        elif args.command == "desktop" and args.action == "on":
            mixed_on()
        elif args.command == "desktop" and args.action == "off":
            mixed_off()
        elif args.command == "codex" and args.action == "launch":
            launch(args.codex_args)
        elif args.command == "codex" and args.action == "smoke":
            smoke(args.model or selection()["default"], args.agents)
    except (SetupError, OSError, ValueError) as exc:
        print(f"bobocodexultra: {exc}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
