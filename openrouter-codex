def router_module():
    """Load the adjacent installed routing service without changing import paths."""
    if sys.version_info < (3, 14):
        raise SetupError("BCU shared desktop routing requires Python 3.14 or newer.")
    if "bcu_router" not in sys.modules:
        path = Path(__file__).resolve().with_name("bcu_router.py")
        if not path.is_file():
            raise SetupError("BCU router module is missing. Reinstall from the complete BCU folder.")
        spec = importlib.util.spec_from_file_location("bcu_router", path)
        module = importlib.util.module_from_spec(spec)
        sys.modules["bcu_router"] = module
        spec.loader.exec_module(module)
    return sys.modules["bcu_router"]


def games_module():
    """Load offline games only when requested; routing never needs curses."""
    if "bcu_games" not in sys.modules:
        path = Path(__file__).resolve().with_name("bcu_games.py")
        if not path.is_file():
            raise SetupError("BCU games module is missing. Reinstall from the complete BCU folder.")
        spec = importlib.util.spec_from_file_location("bcu_games", path)
        module = importlib.util.module_from_spec(spec)
        sys.modules["bcu_games"] = module
        spec.loader.exec_module(module)
    return sys.modules["bcu_games"]


