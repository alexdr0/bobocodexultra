def parse_utc(value: object) -> datetime | None:
    if not isinstance(value, str):
        return None
    try:
        parsed = datetime.fromisoformat(value.replace("Z", "+00:00"))
        return parsed if parsed.tzinfo else parsed.replace(tzinfo=timezone.utc)
    except ValueError:
        return None


def usage_roots(home: Path) -> tuple[Path, Path]:
    return home / "sessions", home / "archived_sessions"


def local_usage_records(home: Path, since: datetime | None = None) -> tuple[list[dict], int]:
    """Read final per-turn counters from OpenRouter Codex rollouts without double-counting totals."""
    records: list[dict] = []
    unreadable = 0
    files = []
    seen: set[tuple] = set()
    for root in usage_roots(home):
        if root.exists():
            files.extend(root.rglob("*.jsonl"))
    for path in files:
        provider = None
        session_id = path.name
        current_model = None
        event_records: list[dict] = []
        structured_records: dict[str, dict] = {}
        try:
            with path.open(errors="strict") as handle:
                for line in handle:
                    obj = json.loads(line)
                    stamp = parse_utc(obj.get("timestamp"))
                    payload = obj.get("payload") or {}
                    kind = obj.get("type")
                    if kind == "session_meta":
                        provider = payload.get("model_provider")
                        session_id = str(payload.get("session_id") or payload.get("id") or session_id)
                    elif kind == "turn_context":
                        current_model = payload.get("model") or current_model
                    if provider != "openrouter" or not current_model:
                        continue
                    usage = None
                    turn_id = None
                    if kind == "token_usage_record":
                        usage = payload.get("turn_token_usage") or payload.get("usage")
                        turn_id = payload.get("turn_id") or payload.get("root_turn_id")
                    elif kind == "event_msg" and payload.get("type") == "token_count":
                        usage = (payload.get("info") or {}).get("last_token_usage")
                        turn_id = payload.get("turn_id") or payload.get("root_turn_id")
                    if not isinstance(usage, dict):
                        continue
                    values = {key: int(usage.get(key) or 0) for key in
                              ("input_tokens", "cached_input_tokens", "cache_write_input_tokens",
                               "output_tokens", "reasoning_output_tokens", "total_tokens")}
                    if not any(values.values()):
                        continue
                    record = {"timestamp": stamp, "model": current_model, **values}
                    if kind == "token_usage_record":
                        key = str(turn_id or f"{current_model}:{len(structured_records)}")
                        record["_dedupe"] = ("turn", session_id, key, current_model)
                        structured_records[key] = record
                    else:
                        record["_dedupe"] = ("event", session_id, stamp.isoformat() if stamp else "", current_model,
                                             *values.values())
                        event_records.append(record)
        except (OSError, UnicodeError, json.JSONDecodeError, TypeError, ValueError):
            unreadable += 1
            continue
        # Newer Codex versions emit structured per-turn records. Older versions emit
        # token_count events. Never combine both formats from one rollout.
        chosen_records = list(structured_records.values()) if structured_records else event_records
        for record in chosen_records:
            identity = record.pop("_dedupe")
            if identity in seen:
                continue
            seen.add(identity)
            if since is None or (record["timestamp"] and record["timestamp"] >= since):
                records.append(record)
    return records, unreadable


def usage_prices(refresh: bool = True) -> tuple[dict[str, dict], str]:
    p = paths()
    cache = p["usage_cache"]
    if refresh:
        try:
            models = openrouter_pricing_catalog()
            prices = {model["id"]: {
                "prompt": str((model.get("pricing") or {}).get("prompt") or ""),
                "completion": str((model.get("pricing") or {}).get("completion") or ""),
                "cache_read": str((model.get("pricing") or {}).get("input_cache_read") or ""),
                "cache_write": str((model.get("pricing") or {}).get("input_cache_write") or ""),
            } for model in models}
            data = {"fetched_at": datetime.now(timezone.utc).isoformat(), "prices": prices}
            atomic_write(cache, (json.dumps(data, indent=2) + "\n").encode())
            return prices, data["fetched_at"]
        except SetupError:
            pass
    if cache.exists():
        data = json.loads(cache.read_text())
        return data.get("prices", {}), data.get("fetched_at", "unknown")
    return {}, "unavailable"


def decimal_price(prices: dict, model: str, key: str) -> Decimal | None:
    try:
        value = Decimal(str((prices.get(model) or {}).get(key, "")))
        return value if value.is_finite() and value >= 0 else None
    except (InvalidOperation, TypeError):
        return None


def estimate_record_cost(record: dict, prices: dict) -> tuple[Decimal | None, bool]:
    prompt = decimal_price(prices, record["model"], "prompt")
    completion = decimal_price(prices, record["model"], "completion")
    if prompt is None or completion is None:
        return None, False
    cached = min(record["cached_input_tokens"], record["input_tokens"])
    cache_write_tokens = min(record["cache_write_input_tokens"], max(0, record["input_tokens"] - cached))
    uncached = max(0, record["input_tokens"] - cached - cache_write_tokens)
    cache_read = decimal_price(prices, record["model"], "cache_read")
    cache_write = decimal_price(prices, record["model"], "cache_write")
    cost = Decimal(uncached) * prompt
    cost += Decimal(cached) * (cache_read if cache_read is not None else prompt)
    cost += Decimal(cache_write_tokens) * (cache_write if cache_write is not None else prompt)
    cost += Decimal(record["output_tokens"]) * completion
    return cost, cache_read is not None


def usage(days: int, as_json: bool, offline: bool) -> None:
    if days < 0:
        raise SetupError("--days must be zero or greater; zero means all locally retained history.")
    since = None if days == 0 else datetime.now(timezone.utc) - timedelta(days=days)
    records, unreadable = local_usage_records(paths()["home"], since)
    prices, fetched = usage_prices(not offline)
    totals: dict[str, dict] = {}
    for record in records:
        bucket = totals.setdefault(record["model"], {key: 0 for key in
            ("turns", "input_tokens", "cached_input_tokens", "cache_write_input_tokens",
             "output_tokens", "reasoning_output_tokens", "total_tokens")})
        bucket["turns"] += 1
        for key in bucket:
            if key != "turns":
                bucket[key] += record[key]
    estimated_total = Decimal(0)
    priced_models = 0
    cache_discount_models = 0
    for model, bucket in totals.items():
        cost = Decimal(0)
        complete = True
        discounted = False
        for record in (item for item in records if item["model"] == model):
            item_cost, item_discounted = estimate_record_cost(record, prices)
            if item_cost is None:
                complete = False
                break
            cost += item_cost
            discounted = discounted or item_discounted
        bucket["estimated_cost_usd"] = float(cost) if complete else None
        if complete:
            estimated_total += cost
            priced_models += 1
            cache_discount_models += int(discounted)
    output = {
        "source": "local Codex rollout token counters",
        "period_days": days,
        "records": len(records), "unreadable_files": unreadable,
        "pricing_catalog_fetched_at": fetched,
        "estimated_total_usd": float(estimated_total) if priced_models == len(totals) else None,
        "models": totals,
    }
    if as_json:
        print(json.dumps(output, indent=2, sort_keys=True))
        return
    UI.section("BCU local usage")
    UI.row("WINDOW", "all retained history" if days == 0 else f"last {days} days")
    UI.row("SOURCE", "Exact tokens from local Codex OpenRouter sessions", "mint")
    if not totals:
        UI.row("RESULT", "No locally recorded OpenRouter token usage found.", "amber")
        return
    for model, bucket in sorted(totals.items(), key=lambda item: item[1]["total_tokens"], reverse=True):
        UI.section(model)
        UI.row("TURNS", f"{bucket['turns']:,}")
        UI.row("INPUT", f"{bucket['input_tokens']:,} ({bucket['cached_input_tokens']:,} cached)")
        UI.row("CACHE WRITE", f"{bucket['cache_write_input_tokens']:,}")
        UI.row("OUTPUT", f"{bucket['output_tokens']:,} (+ {bucket['reasoning_output_tokens']:,} reasoning)")
        UI.row("TOTAL", f"{bucket['total_tokens']:,}", "mint")
        estimate = bucket["estimated_cost_usd"]
        UI.row("EST. COST", f"${estimate:,.6f}" if estimate is not None else "unavailable for current catalog", "amber")
    grand_tokens = sum(bucket["total_tokens"] for bucket in totals.values())
    UI.section("Total")
    UI.row("TOKENS", f"{grand_tokens:,}", "mint")
    UI.row("EST. COST", f"${estimated_total:,.6f}" if priced_models == len(totals) else "partial/unavailable", "amber")
    UI.row("PRICING AS OF", fetched)
    UI.row("IMPORTANT", "Cost is a back-estimate using current base catalog prices, not an invoice.", "amber")
    UI.row("CACHE", "Cached tokens use catalog cache-read price when advertised; otherwise prompt price.")
    if unreadable:
        UI.row("SKIPPED", f"{unreadable} unreadable rollout files", "amber")


def launch(arguments: list[str]) -> None:
    p = paths()
    if not p["profile"].is_file():
        raise SetupError("Run `bobocodexultra auth login` first.")
    if not key_exists():
        raise SetupError("Key not found in macOS Keychain. Run `bobocodexultra auth login`.")
    codex = shutil.which("codex")
    if not codex:
        raise SetupError("Codex CLI is not on PATH.")
    args = arguments[1:] if arguments and arguments[0] == "--" else arguments
    os.execv(codex, [codex, "--profile", "openrouter", *args])


def smoke(model: str, agents: bool) -> None:
    if not key_exists():
        raise SetupError("Key not found in macOS Keychain. Run `auth login` first.")
    if model not in [m["id"] for m in selection()["models"]]:
        raise SetupError("Select the model first with `model add` or `model select`.")
    codex = shutil.which("codex")
    if not codex:
        raise SetupError("Codex CLI is not on PATH.")
    if agents:
        prompt = (
            "Read-only integration check. Spawn exactly two subagents: one should report the "
            "current directory name, the other should report whether it is a git repository. "
            "Wait for both and summarize their results in one short sentence. Do not edit files."
        )
    else:
        prompt = "Read-only integration check: answer with the exact word READY. Do not edit files."
    UI.row("BILLED TEST", f"{'subagent' if agents else 'basic'} check with {model}", "amber")
    result = subprocess.run([
        codex, "exec", "--profile", "openrouter", "--model", model,
        "--sandbox", "read-only", "--skip-git-repo-check", "--ephemeral",
        prompt,
    ], check=False)
    if result.returncode:
        raise SetupError(f"Codex smoke test exited with status {result.returncode}.")


def install() -> None:
    target = Path.home() / ".local" / "bin" / "bobocodexultra"
    alias = target.with_name("boboultracodex")
    source = Path(__file__).resolve()
    if target.is_symlink():
        raise SetupError(f"{target} is a symlink; refusing to replace it.")
    if target.exists() and b"Keychain-backed OpenRouter profile" not in target.read_bytes()[:512]:
        raise SetupError(f"{target} exists and is not this tool; refusing to replace it.")
    if alias.exists() or alias.is_symlink():
        if not alias.is_symlink() or os.readlink(alias) != target.name:
            raise SetupError(f"{alias} already exists; refusing to replace it.")
    if target != source:
        module = source.with_name("bcu_router.py")
        if not module.is_file():
            raise SetupError("Missing bcu_router.py; install from the complete BCU folder.")
        module_target = target.with_name("bcu_router.py")
        if module_target.exists() and not module_target.read_bytes().startswith(b'"""BCU local routing service'):
            raise SetupError("An unrelated bcu_router.py already exists beside the CLI.")
        games_source = source.with_name("bcu_games.py")
        if not games_source.is_file():
            raise SetupError("Missing bcu_games.py; install from the complete BCU folder.")
        games_target = target.with_name("bcu_games.py")
        if games_target.is_symlink() or (games_target.exists() and not games_target.read_bytes().startswith(b'"""BCU terminal arcade')):
            raise SetupError("An unrelated bcu_games.py already exists beside the CLI.")
        atomic_write(module_target, module.read_bytes())
        atomic_write(games_target, games_source.read_bytes())
        atomic_write(target, source.read_bytes(), 0o700)
    if not alias.is_symlink():
        alias.symlink_to(target.name)
    UI.done(f"Installed {target.name} and {alias.name} in {target.parent}")
    if str(target.parent) not in os.environ.get("PATH", "").split(os.pathsep):
        print("Add ~/.local/bin to PATH in your shell startup file, then open a new terminal.")
    else:
        UI.row("NEXT", "Run `bobocodexultra docs` from any directory.")


