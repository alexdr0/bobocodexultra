def legacy_arguments(argv: list[str]) -> list[str]:
    """Keep commands from earlier versions working without cluttering new help."""
    aliases = {
        "login": ("auth", "login"), "on": ("desktop", "on"), "off": ("desktop", "off"),
        "add": ("model", "add"), "remove": ("model", "remove"),
        "default": ("model", "default"), "sync": ("model", "sync"),
        "setup": ("auth", "login"), "prepare": ("auth", "prepare"),
        "models": ("model",), "desktop-on": ("desktop", "on"),
        "desktop-off": ("desktop", "off"), "launch": ("codex", "launch"),
        "smoke": ("codex", "smoke"),
    }
    return [*aliases.get(argv[0], (argv[0],)), *argv[1:]] if argv else argv


