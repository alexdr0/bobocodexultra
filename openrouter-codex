        + provider_toml()
    ).encode()


def prepare(refresh: bool = False) -> dict[str, Path]:
    ensure_macos()
    p = paths()
    p["home"].mkdir(mode=0o700, parents=True, exist_ok=True)
    chosen = selection()
    catalog = catalog_bytes(p["home"], chosen)
    profile = profile_bytes(p["catalog"], chosen["default"])
    tomllib.loads(profile.decode())
    if not refresh:
        verify_managed(chosen, p)
    write_if_new_or_equal(p["catalog"], catalog, refresh)
    write_if_new_or_equal(p["profile"], profile, refresh)
    chosen.update(catalog_sha256=sha(catalog), profile_sha256=sha(profile))
    atomic_write(p["selection"], (json.dumps(chosen, indent=2) + "\n").encode())
    UI.done(f"Codex profile ready: {p['profile']}")
    UI.done(f"{len(chosen['models'])}-model catalog ready: {p['catalog']}")
    return p


def verify_managed(chosen: dict, p: dict[str, Path]) -> None:
    for label in ("catalog", "profile"):
        expected = chosen.get(label + "_sha256")
        if expected and (not p[label].exists() or sha(p[label].read_bytes()) != expected):
            raise SetupError(f"{p[label]} changed outside this tool; refusing to overwrite it.")


def openrouter_models(query: str = "", limit: int | None = 100) -> list[dict]:
    url = "https://openrouter.ai/api/v1/models?" + urllib.parse.urlencode({
        "sort": "most-popular", "supported_parameters": "tools", "q": query,
    })
    try:
        with UI.spinner("Scanning OpenRouter models"):
            with urllib.request.urlopen(urllib.request.Request(url, headers={"User-Agent": "bobocodexultra/1"}), timeout=20) as response:
                raw = response.read(8_000_001)
                if len(raw) > 8_000_000:
                    raise SetupError("OpenRouter catalog response is unexpectedly large.")
                models = json.loads(raw)["data"]
    except (urllib.error.URLError, KeyError, ValueError) as exc:
        raise SetupError(f"Could not load OpenRouter models: {exc}") from exc
    return [m for m in models if isinstance(m, dict) and isinstance(m.get("id"), str)
            and MODEL_ID.fullmatch(m["id"]) and "tools" in (m.get("supported_parameters") or [])
            and isinstance(m.get("context_length"), int) and m["context_length"] >= 8192][:limit]


def openrouter_pricing_catalog() -> list[dict]:
    url = "https://openrouter.ai/api/v1/models?" + urllib.parse.urlencode({"limit": 1000, "output_modalities": "text"})
    try:
