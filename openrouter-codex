    # No key material is embedded in this block. Codex consumes stdout from -w.
    return (
        "[model_providers.openrouter]\n"
        'name = "OpenRouter"\n'
        'base_url = "https://openrouter.ai/api/v1"\n'
        'wire_api = "responses"\n'
        "supports_websockets = false\n\n"
        "[model_providers.openrouter.auth]\n"
        'command = "/usr/bin/security"\n'
        f"args = {json.dumps(['find-generic-password', '-a', ACCOUNT, '-s', SERVICE, '-w'])}\n"
        "refresh_interval_ms = 0\n"
    )


def profile_bytes(catalog: Path, default: str = DEFAULT_MODEL) -> bytes:
    return (
        f"# OpenRouter profile created by openrouter-codex. No credentials here.\n"
        f"model = {json.dumps(default)}\n"
        'model_provider = "openrouter"\n'
        f"model_catalog_json = {json.dumps(str(catalog))}\n"
        'model_reasoning_effort = "high"\n'
