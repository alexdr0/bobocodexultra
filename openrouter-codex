def ensure_macos() -> None:
    if sys.platform != "darwin" or not Path("/usr/bin/security").exists():
        raise SetupError("This tool requires macOS Keychain (/usr/bin/security).")


def key_exists() -> bool:
    ensure_macos()
    result = subprocess.run(
        ["/usr/bin/security", "find-generic-password", "-a", ACCOUNT, "-s", SERVICE],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    return result.returncode == 0


def save_key() -> None:
    ensure_macos()
    if not sys.stdin.isatty() or not sys.stderr.isatty():
        raise SetupError("Run `bobocodexultra auth login` in an interactive Terminal; the key prompt needs a TTY.")
    UI.section("Keychain handoff")
    UI.row("INPUT", "macOS securely prompts for the OpenRouter key", "amber")
    UI.row("STORAGE", "login Keychain; never in arguments, environment, or config", "mint")
    # Per `security help add-generic-password`, a terminal -w prompts securely.
    # Never append a value to -w or use -A (allow every app).
    result = subprocess.run(
        [
            "/usr/bin/security", "add-generic-password", "-U", "-a", ACCOUNT,
            "-s", SERVICE, "-l", "Codex OpenRouter API key", "-w",
        ],
        check=False,
    )
    if result.returncode:
        raise SetupError("Keychain did not store the key; configuration was not activated.")
    if not key_exists():
        raise SetupError("Keychain item could not be found after entry.")
    UI.done("Key stored in macOS Keychain. This tool did not read its value.")


def sha(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def atomic_write(path: Path, data: bytes, mode: int = 0o600) -> None:
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    fd, name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        os.fchmod(fd, mode)
        with os.fdopen(fd, "wb") as handle:
            handle.write(data)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(name, path)
    finally:
        if os.path.exists(name):
            os.unlink(name)


def write_if_new_or_equal(path: Path, data: bytes, refresh: bool = False) -> None:
    if path.exists():
        if path.read_bytes() != data:
            if not refresh:
                raise SetupError(f"{path} differs; use `auth prepare --refresh` to back up and replace it.")
            backup = path.with_name(f"{path.name}.backup-{time.strftime('%Y%m%d-%H%M%S')}-{os.getpid()}")
            atomic_write(backup, path.read_bytes())
            atomic_write(path, data)
            print(f"Saved prior version: {backup}")
        return
    atomic_write(path, data)


def source_template(home: Path) -> dict:
    candidates = (home / "ollama-launch-models.json", home / "model.json")
    for path in candidates:
        if path.is_file():
            try:
                models = json.loads(path.read_text()).get("models", [])
                for item in models:
                    if item.get("slug") == "kimi-k3:cloud":
                        return copy.deepcopy(item)
            except (OSError, ValueError, AttributeError):
                pass
    # The fields below are the conservative model-preset subset used by Codex.
    return {
        "slug": "", "display_name": "", "description": "", "visibility": "list",
        "supported_in_api": True, "context_window": 200_000,
        "default_reasoning_level": "high", "supported_reasoning_levels": [],
        "supports_parallel_tool_calls": True, "input_modalities": ["text"],
        "shell_type": "unified_exec", "apply_patch_tool_type": None,
            "base_instructions": "You are Codex, a coding agent. Work carefully with the user's files and tools.",
    }


def initial_selection() -> dict:
    return {"default": DEFAULT_MODEL, "models": [
        {"id": slug, "name": display.removeprefix("OpenRouter · "),
         "context_length": context, "images": images} for slug, display, context, images in MODELS
    ]}


def selection() -> dict:
    path = paths()["selection"]
    value = json.loads(path.read_text()) if path.exists() else initial_selection()
    models = value.get("models")
    if not isinstance(models, list) or not models or any(
        not isinstance(m, dict) or not isinstance(m.get("id"), str)
        or not MODEL_ID.fullmatch(m["id"])
        or not isinstance(m.get("name"), str)
        or not isinstance(m.get("context_length"), int) or m["context_length"] < 8192
        or not isinstance(m.get("images"), bool) for m in models
    ):
        raise SetupError(f"Invalid model selection in {path}")
    ids = [m["id"] for m in models]
    if len(set(ids)) != len(ids) or value.get("default") not in ids:
        raise SetupError(f"Invalid or duplicate models/default in {path}")
    return value


def catalog_bytes(home: Path, selected: dict | None = None) -> bytes:
    selected = selected or selection()
    template = source_template(home)
    models = []
    for priority, chosen in enumerate(selected["models"]):
        slug, context, images = chosen["id"], chosen["context_length"], chosen["images"]
        item = copy.deepcopy(template)
        item.update({
            "slug": slug,
            "display_name": selector_name(chosen["name"]),
            "description": "OpenRouter Responses API model; verify tool behavior before sensitive work.",
            "context_window": context,
            "max_context_window": context,
            "default_reasoning_level": "high",
            "supported_reasoning_levels": [
                {"effort": "high", "description": "High reasoning for agentic work"}
            ],
            "input_modalities": ["text", "image"] if images else ["text"],
            "visibility": "list",
            "supported_in_api": True,
            "supports_parallel_tool_calls": True,
            "supports_reasoning_summaries": False,
            "supports_reasoning_summary_parameter": False,
            "experimental_supported_tools": [],
            "additional_speed_tiers": [],
            "service_tiers": [],
            "priority": priority,
        })
        item["base_instructions"] = BASE_INSTRUCTIONS
        models.append(item)
    return (json.dumps({"models": models}, indent=2, ensure_ascii=False) + "\n").encode()


