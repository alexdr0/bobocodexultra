def mixed_on() -> None:
    ensure_macos()
    if sys.version_info < (3, 14):
        raise SetupError("The BCU router needs Python 3.14+ for Codex's zstd request compression.")
    if not key_exists():
        raise SetupError("Run `bobocodexultra login` to save your OpenRouter key first.")
    # Migrate the earlier global-provider implementation through its safe restore.
    if paths()["state"].exists():
        native_reset()
    prepare()
    install()
    mixed_controller().enable()
    UI.done("Shared desktop mode is on: native ChatGPT + Ollama + BCU models.")
    UI.row("NEXT", "Quit and reopen Codex once to load the combined selector.")


def mixed_off() -> None:
    control = mixed_controller()
